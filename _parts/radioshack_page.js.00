const S13={"Alabama":48,"Alaska":0,"Arizona":61,"Arkansas":27,"California":532,"Colorado":60,"Connecticut":67,"Delaware":18,"Florida":283,"Georgia":98,"Hawaii":24,"Idaho":17,"Illinois":161,"Indiana":92,"Iowa":30,"Kansas":35,"Kentucky":52,"Louisiana":68,"Maine":22,"Maryland":95,"Massachusetts":110,"Michigan":118,"Minnesota":52,"Mississippi":36,"Missouri":70,"Montana":5,"Nebraska":18,"Nevada":35,"New Hampshire":31,"New Jersey":152,"New Mexico":31,"New York":328,"North Carolina":116,"North Dakota":6,"Ohio":180,"Oklahoma":37,"Oregon":51,"Pennsylvania":210,"Rhode Island":20,"South Carolina":56,"South Dakota":10,"Tennessee":66,"Texas":356,"Utah":27,"Vermont":9,"Virginia":117,"Washington":88,"West Virginia":28,"Wisconsin":64,"Wyoming":6,"District of Columbia":12};
const S09={"Alabama":48,"Alaska":0,"Arizona":79,"Arkansas":25,"California":550,"Colorado":63,"Connecticut":70,"Delaware":19,"Florida":299,"Georgia":100,"Hawaii":24,"Idaho":19,"Illinois":173,"Indiana":98,"Iowa":35,"Kansas":37,"Kentucky":56,"Louisiana":67,"Maine":22,"Maryland":98,"Massachusetts":113,"Michigan":120,"Minnesota":62,"Mississippi":37,"Missouri":72,"Montana":7,"Nebraska":21,"Nevada":38,"New Hampshire":32,"New Jersey":159,"New Mexico":32,"New York":333,"North Carolina":124,"North Dakota":6,"Ohio":187,"Oklahoma":39,"Oregon":51,"Pennsylvania":210,"Rhode Island":21,"South Carolina":53,"South Dakota":11,"Tennessee":68,"Texas":374,"Utah":28,"Vermont":9,"Virginia":124,"Washington":91,"West Virginia":28,"Wisconsin":70,"Wyoming":7,"District of Columbia":13};
const D13={"Alabama":17,"Alaska":20,"Arizona":15,"Arkansas":26,"California":33,"Colorado":22,"Connecticut":1,"Delaware":0,"Florida":26,"Georgia":29,"Hawaii":0,"Idaho":11,"Illinois":36,"Indiana":30,"Iowa":38,"Kansas":21,"Kentucky":23,"Louisiana":13,"Maine":11,"Maryland":4,"Massachusetts":5,"Michigan":37,"Minnesota":29,"Mississippi":11,"Missouri":27,"Montana":23,"Nebraska":15,"Nevada":5,"New Hampshire":5,"New Jersey":4,"New Mexico":10,"New York":14,"North Carolina":23,"North Dakota":3,"Ohio":23,"Oklahoma":22,"Oregon":19,"Pennsylvania":22,"Rhode Island":0,"South Carolina":13,"South Dakota":12,"Tennessee":22,"Texas":52,"Utah":14,"Vermont":7,"Virginia":27,"Washington":23,"West Virginia":8,"Wisconsin":37,"Wyoming":13,"District of Columbia":0};
