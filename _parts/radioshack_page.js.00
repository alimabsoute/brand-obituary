(function(){
const B=window.BO,{$,$$,C,fn,mob,tip,mk,lazy,seg,rNote,roughPlug,refLine}=B;
B.basics();
// ---- cause of death ----
B.cod([
 [30,'Dependence on phones sold on carriers’ terms','Wireless went from 28.7% of sales in 2003 to a 52.4% mobility share in 2013. In 2012 and 2013 the company sold fewer postpaid phones, paid more for each, and repaid commissions when customers dropped service. The 10-K calls the result a “substantial decrease in consolidated gross profit.”',[9,13]],
 [25,'A footprint that never shrank to fit','Company stores peaked at 5,289 in 2001 and were still 4,297 at the end of 2013. Apart from 2006, store counts barely moved while sales per store fell by about a fifth between 2005 and 2013 (derived).',[6,10,13]],
 [20,'The reason to visit moved elsewhere','The chain was built on batteries, parts and advice. The archived home pages show the parts business shrinking to a sidebar as phones took over. Online competition is general context; our sources don’t quantify it.',[33]],
 [15,'Five chief executives in eight years','Edmondson resigned over his résumé in 2006; Day, Gooch and Magnacca followed, each with a new strategy, including “The Shack” in 2009 and the ’80s ad in 2014.',[17,10,19,13]],
 [10,'No cushion when it mattered','Equity fell from $1,048.3M in 2009 to $206.4M in 2013, and cash from $908.2M to $43.3M by November 2014. There was no room left to close stores in an orderly way.',[13,14]]]);
// ---- timeline ----
const TL=[
 ['1921','Boston','corporate','A radio-parts store opens','Theodore and Milton Deutschmann open the first store, according to the brand’s 2020 owner.',[28]],
 ['1963','Fort Worth','corporate','Tandy buys the chain','Charles Tandy’s company acquires the struggling Boston chain and makes it profitable within two years.',[18]],
 ['1977','','ops','The TRS-80','Tandy sells its own personal computer through the stores (year from general knowledge).',[18]],
 ['1988','','ops','More than 7,000 locations','Company stores and dealers combined pass 7,000.',[18]],
 ['1999','Q4','money','Stock peaks','Shares trade as high as $79.50, split-adjusted.',[4]],
 ['2000','','corporate','Tandy becomes RadioShack Corporation','Net income reaches $368.0M, the most in our data.',[5,18]],
 ['2001','Dec 31','ops','5,289 company stores','The most the chain ever operated, plus 2,119 dealer outlets.',[6]],
 ['2005','','money','Sales peak at $5.08B','Net income has already fallen to $267.0M.',[9]],
 ['2006','Feb','corporate','CEO resigns over résumé','David Edmondson steps down after questions about degrees he claimed.',[17]],
 ['2006','Jul','corporate','Julian Day becomes CEO','He takes over as chairman and chief executive.',[10]],
 ['2006','Aug','corporate','Layoffs by email','About 400 headquarters employees are told by email that their jobs are gone.',[22]],
 ['2006','Dec 31','ops','505 fewer stores','Company stores fall from 4,972 to 4,467, the only large cut before bankruptcy.',[9,10]],
 ['2009','Aug','corporate','“The Shack”','The company starts calling itself The Shack in advertising.',[23,36]],
 ['2011','May','corporate','James Gooch becomes CEO','The former CFO is promoted from president.',[19]],
 ['2012','','money','First annual loss in our data','A net loss of $139.4M. The share price falls below $3.',[13]],
 ['2013','Feb','corporate','Joseph Magnacca becomes CEO','He arrives from Walgreens.',[13]],
 ['2013','Mar','ops','Out of Target','All 1,522 Target Mobile centers are closed or handed off by March 31.',[13]],
 ['2013','','money','A $400.2M loss','Equity falls to $206.4M.',[13]],
 ['2014','Feb 2','corporate','“The ’80s called”','A Super Bowl ad mocks the company’s own old stores.',[24]],
 ['2014','Nov 1','money','$43.3M in cash','Down from $908.2M at the end of 2009.',[14]],
 ['2015','Feb 5','death','Chapter 11','Filed in Delaware with a plan to sell up to 2,400 stores to a Standard General affiliate.',[15,20,25]],
 ['2015','Apr','death','1,743 stores sold','General Wireless buys them; many are co-branded with Sprint. The rest close.',[16,21]],
 ['2017','Mar','death','Second bankruptcy','General Wireless files for Chapter 11 and starts closing stores.',[26]],
 ['2020','Nov','death','Sold to an e-commerce roll-up','Retail Ecommerce Ventures buys the brands.',[28,29]],
 ['2022','','death','A crypto token','radioshack.com becomes a waitlist for a cryptocurrency project.',[32,33]],
 ['2023','May','death','Unicomer buys the brand','The Salvadoran retailer acquires the IP in about 70 countries.',[30,31]]];
$('#tlv').innerHTML=TL.map(e=>`<div class="ev" data-cat="${e[2]}"><div class="d"><b>${e[0]}</b>${e[1]}</div><div class="dot"></div><div><div class="c">${{money:'Money',corporate:'Corporate',ops:'Stores',death:'Death &amp; estate'}[e[2]]}</div><h4>${e[3]}</h4><p>${e[4]}${fn(e[5])}</p></div></div>`).join('');
$$('#tlv .ev').forEach(x=>{const d=x.querySelector('.dot');if(x.dataset.cat==='ops')d.style.background=C.BLUE;if(x.dataset.cat==='death')d.style.background=C.RED});
// ---- data ----
const YR=[];for(let y=1995;y<=2014;y++)YR.push(y);
const REV=[5.839,6.286,5.372,4.788,4.126,4.795,4.776,4.577,4.649,4.841,5.082,4.778,4.252,4.225,4.066,4.201,4.032,3.831,3.434,2.061];
const NI=[null,null,null,null,297.9,368.0,166.7,263.4,298.5,337.2,267.0,73.4,236.8,192.4,205.0,206.1,72.2,-139.4,-400.2,-396.8];
const ST=[4831,4942,4972,5039,5087,5109,5289,5161,5121,5046,4972,4467,4447,4453,4476,4486,4476,4395,4297,4216];
const DL=[2005,1927,1934,1991,2099,2090,2119,2052,1921,1788];
const lab=y=>y===2014?(mob()?'14*':'2014*'):(mob()?"'"+String(y).slice(2):String(y));
if(!B.setupChart())return;
// sales & net income
lazy('revChart',()=>mk('revChart',{data:{labels:YR.map(lab),datasets:[
 {type:'line',label:'Net income ($M, right)',data:NI,borderColor:C.RED,backgroundColor:C.RED,yAxisID:'y1',tension:.25,pointRadius:3,spanGaps:false,order:0},
 {type:'bar',label:'Net sales ($B, left)',data:REV,backgroundColor:YR.map(y=>y<1999?C.SAND:y===2014?'#d9d4ca':C.INK),borderRadius:1,order:1}]},
 options:{interaction:{mode:'index',intersect:false},plugins:{legend:{position:'bottom'},tooltip:{...tip,callbacks:{title:i=>{const y=YR[i[0].dataIndex];return y===2014?'2014, first 39 weeks':y<1999?y+' (Tandy Corporation)':String(y)},label:c=>c.raw==null?'':c.dataset.yAxisID==='y1'?' Net income: $'+c.raw.toFixed(1)+'M':' Sales: $'+c.raw.toFixed(2)+'B'}}},
 scales:{y:{min:0,max:7,grid:{color:C.GRID},ticks:{callback:v=>'$'+v+'B'}},y1:{position:'right',min:-500,max:500,grid:{display:false},ticks:{callback:v=>'$'+v+'M'}},x:{grid:{display:false},ticks:{maxRotation:0,autoSkip:true,font:{size:mob()?9:12}}}}},
 plugins:[refLine(0,'y1',''),roughPlug((c,rc,ctx)=>{const m=c.getDatasetMeta(0).data;const p=m[18],q=m[5];if(p)rNote(rc,ctx,p.x-300,p.y-12,['2013: a $400.2M loss, the','worst full year in our data.'],[p.x-8,p.y],7);if(q)rNote(rc,ctx,q.x+30,c.chartArea.top+4,['2000: $368.0M profit,','the high point.'],[q.x+4,q.y-6],11)})]}));
// per store
const PS=YR.slice(4,19).map((y,i)=>+(REV[i+4]*1000/ST[i+4]).toFixed(2));
lazy('perStoreChart',()=>mk('perStoreChart',{type:'line',data:{labels:YR.slice(4,19).map(lab),datasets:[{label:'Sales per company store ($M)',data:PS,borderColor:C.INK,backgroundColor:'rgba(29,27,24,.06)',fill:true,tension:.2,pointRadius:3}]},
 options:{plugins:{legend:{display:false},tooltip:{...tip,callbacks:{label:c=>' $'+c.raw.toFixed(2)+'M per store (derived)'}}},scales:{y:{min:0.6,max:1.2,grid:{color:C.GRID},ticks:{callback:v=>'$'+v.toFixed(1)+'M'}},x:{grid:{display:false},ticks:{maxRotation:0,font:{size:mob()?9:12}}}}},
 plugins:[roughPlug((c,rc,ctx)=>{const m=c.getDatasetMeta(0).data;const a=m[2],b=m[14];if(a&&b){rNote(rc,ctx,b.x-330,c.chartArea.top+6,['2013: about $0.80M a store,','down from $1.02M in 2005.'],[b.x-6,b.y-6],5)}})]}));
// mix & margin
const MY=[2002,2003,2004,2005,2006,2007,2008,2009,2010,2011,2012,2013];
const WS={2003:28.7,2004:33.8,2005:34.3,2007:33.3,2008:32.8,2009:38.2},MS={2011:50.0,2012:52.4,2013:52.4},GM={2002:48.9,2003:49.8,2004:50.3,2005:46.7,2011:42.7,2012:38.4,2013:34.1};
lazy('mixChart',()=>mk('mixChart',{type:'line',data:{labels:MY.map(lab),datasets:[
 {label:'Wireless share of sales',data:MY.map(y=>WS[y]??null),borderColor:C.BLUE,backgroundColor:C.BLUE,pointRadius:3,spanGaps:true},
 {label:'Mobility share (new definition)',data:MY.map(y=>MS[y]??null),borderColor:C.BLUE,backgroundColor:'#fff',borderDash:[5,4],pointRadius:3},
 {label:'Gross margin',data:MY.map(y=>GM[y]??null),borderColor:C.RED,backgroundColor:C.RED,pointRadius:3,spanGaps:false}]},
 options:{plugins:{legend:{position:'bottom'},tooltip:{...tip,callbacks:{label:c=>c.raw==null?'':' '+c.dataset.label+': '+c.raw.toFixed(1)+'%'}}},scales:{y:{min:20,max:60,grid:{color:C.GRID},ticks:{callback:v=>v+'%'}},x:{grid:{display:false},ticks:{maxRotation:0,font:{size:mob()?9:11}}}}}}));
// postpaid
lazy('postpaidChart',()=>mk('postpaidChart',{type:'bar',data:{labels:['Postpaid phones sold','Average cost per phone','Average revenue per phone'],datasets:[
 {label:'2012',data:[-20,36,19],backgroundColor:C.TAN},{label:'2013',data:[-23,14.3,7],backgroundColor:C.RED}]},
 options:{plugins:{legend:{position:'bottom'},tooltip:{...tip,callbacks:{label:c=>' '+c.dataset.label+': '+(c.raw>0?'+':'')+c.raw+'%'}}},scales:{y:{min:-30,max:40,grid:{color:C.GRID},ticks:{callback:v=>(v>0?'+':'')+v+'%'}},x:{grid:{display:false},ticks:{font:{size:mob()?9:11},callback:function(v){const l=this.getLabelForValue(v);return mob()?l.split(' ').slice(-2).join(' '):l}}}}},plugins:[refLine(0,'y','')]}));
// ads
const AD=[199.9,227.1,253.9,241.0,254.4,271.5,263.1,216.3,208.8,214.5,193.0,206.1,208.9,182.9,176.2];
lazy('adChart',()=>mk('adChart',{data:{labels:YR.slice(4,19).map(lab),datasets:[
 {type:'line',label:'Share of net sales (derived)',data:AD.map((a,i)=>+(a/REV[i+4]/10).toFixed(2)),borderColor:C.RED,backgroundColor:C.RED,yAxisID:'y1',pointRadius:3,tension:.2,order:0},
 {type:'bar',label:'Advertising expense ($M)',data:AD,backgroundColor:C.TAN,borderRadius:1,order:1}]},
 options:{interaction:{mode:'index',intersect:false},plugins:{legend:{position:'bottom'},tooltip:{...tip,callbacks:{label:c=>c.dataset.yAxisID==='y1'?' '+c.raw.toFixed(1)+'% of sales':' $'+c.raw.toFixed(1)+'M'}}},scales:{y:{min:0,max:300,grid:{color:C.GRID},ticks:{callback:v=>'$'+v+'M'}},y1:{position:'right',min:0,max:7,grid:{display:false},ticks:{callback:v=>v+'%'}},x:{grid:{display:false},ticks:{maxRotation:0,font:{size:mob()?9:12}}}}},
 plugins:[roughPlug((c,rc,ctx)=>{const m=c.getDatasetMeta(1).data;const p=m[10];if(p)rNote(rc,ctx,p.x-90,c.chartArea.top+2,['2009: “The Shack” launches','as spending drops to $193M.'],[p.x,p.y-4],13)})]}));
// stock
const SQ={1996:[[12.06,8.53],[14.78,11.19],[11.84,9.56],[11.81,9.28]],1997:[[13.44,10.16],[14.44,12.19],[17.39,13.16],[23.0,16.66]],1998:[[24.44,15.19],[27.31,20.53],[31.94,25.41],[26.63,18.5]],1999:[[32.06,20.59],[51.0,30.09],[56.75,37.38],[79.5,41.38]],2000:[[57.25,35.06],[59.5,38.25],[69.75,45.56],[72.94,39.34]],2001:[[56.5,31.31],[38.5,25.27],[33.85,20.10],[31.6,23.11]],2002:[[31.85,26.13],[36.21,27.5],[30.25,19.11],[24.72,16.99]],2003:[[22.65,18.74],[27.0,21.45],[31.62,25.37],[32.48,27.9]],2004:[[36.24,28.86],[33.73,28.28],[31.27,26.04],[34.06,28.09]],2005:[[34.48,23.75],[26.43,23.11],[27.24,22.81],[25.0,20.55]],2006:[[22.9,18.74],[18.83,14.0],[19.71,13.76],[20.4,16.49]],2007:[[27.88,16.69],[35.0,26.66],[34.98,20.09],[23.42,16.72]],2008:[[19.46,13.31],[17.62,11.93],[19.9,11.56],[17.28,8.06]],2009:[[12.95,6.47],[15.2,8.38],[17.45,12.66],[20.57,14.82]],2010:[[23.91,18.55],[24.0,17.7],[23.16,17.87],[23.38,17.93]],2011:[[18.74,13.61],[16.7,12.28],[16.25,11.38],[13.94,9.15]],2012:[[11.1,6.14],[6.38,3.78],[4.17,2.36],[2.71,1.9]],2013:[[3.87,2.08],[4.28,2.94],[4.36,2.18],[3.88,2.57]]};
const SL=[],SD=[];Object.keys(SQ).forEach(y=>SQ[y].forEach((q,i)=>{SL.push('Q'+(i+1)+' '+y);SD.push([q[1],q[0]])}));
lazy('stockChart',()=>mk('stockChart',{type:'bar',data:{labels:SL,datasets:[{label:'Quarterly range',data:SD,backgroundColor:SL.map(l=>l.endsWith('1999')&&l.startsWith('Q4')?C.RED:C.TAN),borderRadius:1,barPercentage:.8,categoryPercentage:.9}]},
 options:{plugins:{legend:{display:false},tooltip:{...tip,callbacks:{label:c=>' Low $'+c.raw[0].toFixed(2)+' · High $'+c.raw[1].toFixed(2)}}},scales:{y:{min:0,max:85,grid:{color:C.GRID},ticks:{callback:v=>'$'+v}},x:{grid:{display:false},ticks:{maxRotation:0,autoSkip:false,font:{size:mob()?9:11},callback:function(v,i){const l=SL[i];if(!l.startsWith('Q1'))return '';const y=l.slice(3);return mob()?(+y%4===0?"'"+y.slice(2):''):(+y%2===0?y:'')}}}}},
 plugins:[roughPlug((c,rc,ctx)=>{const m=c.getDatasetMeta(0).data;const p=m[15],q=m[65];if(p)rNote(rc,ctx,p.x+24,c.chartArea.top+4,['Q4 1999: as high as $79.50,','the all-time peak.'],[p.x+5,p.y+4],3);if(q)rNote(rc,ctx,q.x-310,c.chartArea.top+110,['2012: below $3, for good.'],[q.x-2,q.y-6],9)})]}));
// balance sheet
lazy('balChart',()=>mk('balChart',{type:'bar',data:{labels:['2009','2010','2011','2012','2013','Nov 2014'],datasets:[
 {label:'Cash',data:[908.2,569.4,591.7,535.7,179.8,43.3],backgroundColor:C.GREEN},{label:'Long-term debt',data:[627.8,331.8,670.6,499.0,613.0,null],backgroundColor:C.RED},{label:'Stockholders’ equity',data:[1048.3,842.5,753.3,598.7,206.4,null],backgroundColor:C.INK}]},
 options:{plugins:{legend:{position:'bottom'},tooltip:{...tip,callbacks:{label:c=>c.raw==null?'':' '+c.dataset.label+': $'+c.raw.toFixed(1)+'M'}}},scales:{y:{min:0,grid:{color:C.GRID},ticks:{callback:v=>'$'+v+'M'}},x:{grid:{display:false},ticks:{font:{size:mob()?9:11}}}}}}));
// gross profit vs SG&A
lazy('gpChart',()=>mk('gpChart',{type:'line',data:{labels:['Q1 12','Q2 12','Q3 12','Q4 12','Q1 13','Q2 13','Q3 13','Q4 13'],datasets:[
 {label:'Gross profit',data:[370.1,340.2,340.8,419.3,337.3,313.8,242.7,278.4],borderColor:C.GREEN,backgroundColor:C.GREEN,pointRadius:3,tension:.2},
 {label:'SG&A',data:[345.3,337.0,354.0,383.5,337.9,336.9,343.3,389.3],borderColor:C.RED,backgroundColor:C.RED,pointRadius:3,tension:.2}]},
 options:{interaction:{mode:'index',intersect:false},plugins:{legend:{position:'bottom'},tooltip:{...tip,callbacks:{label:c=>' '+c.dataset.label+': $'+c.raw.toFixed(1)+'M'}}},scales:{y:{min:200,max:450,grid:{color:C.GRID},ticks:{callback:v=>'$'+v+'M'}},x:{grid:{display:false},ticks:{font:{size:mob()?9:11}}}}},
 plugins:[roughPlug((c,rc,ctx)=>{const a=c.getDatasetMeta(0).data[6];const b=c.getDatasetMeta(1).data[6];if(a&&b)rNote(rc,ctx,a.x-240,a.y+4,['Q3 2013: a $100.6M gap'],[a.x-4,(a.y+b.y)/2],17)})]}));
// store counts
lazy('countChart',()=>mk('countChart',{type:'bar',data:{labels:YR.map(lab),datasets:[
 {label:'Company-operated stores',data:ST,backgroundColor:YR.map(y=>y===2001?C.RED:C.INK),stack:'s',borderRadius:0},
 {label:'Dealer and franchise outlets',data:YR.map((y,i)=>DL[i]??null),backgroundColor:C.SAND,stack:'s'}]},
 options:{interaction:{mode:'index',intersect:false},plugins:{legend:{position:'bottom'},tooltip:{...tip,callbacks:{title:i=>YR[i[0].dataIndex]===2014?'Nov 1, 2014':String(YR[i[0].dataIndex]),label:c=>c.raw==null?'':' '+c.dataset.label+': '+c.raw.toLocaleString()}}},scales:{y:{min:0,max:8000,stacked:true,grid:{color:C.GRID},ticks:{callback:v=>v.toLocaleString()}},x:{stacked:true,grid:{display:false},ticks:{maxRotation:0,font:{size:mob()?9:12}}}}},
 plugins:[roughPlug((c,rc,ctx)=>{const m=c.getDatasetMeta(0).data,top=c.chartArea.top;const p=m[6],q=m[11],r=m[18];
  if(p)rNote(rc,ctx,p.x-40,top+2,['2001: 5,289 company stores,','the peak.'],[p.x,p.y-4],3);
  if(q)rNote(rc,ctx,q.x-20,top+70,['2006: 505 closed. The only big cut.'],[q.x,q.y-4],7);
  if(r)rNote(rc,ctx,r.x-235,top+0,['2013: 4,297, a year before','bankruptcy. 1,743 were sold in 2015.'],[r.x,r.y-4],13)})]}));
