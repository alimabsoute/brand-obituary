const PINS=[{lab:'1',cat:'e',ll:[-71.06,42.36],off:[34,22],title:'Boston, MA: where it began',text:'The first store opened here in 1921.',src:[28]},
 {lab:'2',cat:'c',ll:[-97.33,32.75],off:[-30,-26],title:'Fort Worth, TX: headquarters',text:'Tandy bought the chain in 1963 and ran it from here. The last head office was at 300 RadioShack Circle.',src:[18,13]}];
