const US=[
 ['1','pets',[37,264],null,'Bay Area: headquarters and first warehouse','Offices on Brannan and Bryant streets in San Francisco, plus the 143,232 sq ft Union City distribution center (Jul 1999). Rivals Petopia (SF) and Petstore.com (Emeryville) were also here. See Map 2.',[1,6,28,31]],
 ['2','pets',MD.pts.greenwood,null,'Greenwood, Indiana: second warehouse','Leased Dec 7, 1999 near Indianapolis. Once it “reached its full load of U.S. shipping” in mid-2000, gross margin improved from −20% to −3%.',[4,6]],
 ['3','riv',MD.pts.pasadena,[122,350],'PetSmart.com, Pasadena','A PetSmart/Idealab joint venture that used PetSmart’s catalog fulfillment. It pulled its $115M IPO in Nov 2000, then bought the pets.com domain.',[32,34,6]],
 ['4','back',MD.pts.seattle,null,'Amazon.com, Seattle','Largest shareholder: 40.7% before the IPO and 30.4% after. It later said the stake was worth “down to zero.”',[1,11]],
 ['5','back',MD.pts.burbank,[62,334],'Disney / Catalyst Investments, Burbank','A Disney affiliate with 3.7%. ABC airtime worth $11.02M was paid for in Pets.com stock.',[1]],
 ['6','back',MD.pts.phoenix,null,'PetSmart, Phoenix','Parent of PetSmart.com. It raised its stake from 48% to 81% after the IPO was withdrawn.',[34]],
 ['7','back',MD.pts.sandiego,[100,406],'Petco, San Diego','Backed Petopia and shipped its orders from Petco distribution centers, then bought Petopia’s assets in Dec 2000.',[28,30]],
 ['8','back',MD.pts.nyc,null,'Merrill Lynch, New York','Led the Feb 2000 IPO, then approached 50+ potential buyers in 2000. Fewer than 8 would even visit.',[1,5]],
];
const USN=[ // notes: [pinLabel, x,y, lines, target]
 ['1',122,140,['Bay Area: HQ in SoMa + the Union City','warehouse (143,232 sq ft, 1999).','Goods + shipping cost more than','sales in every quarter reported.'],[60,256]],
 ['2',560,415,['Greenwood, IN warehouse (Dec ’99).','Once at full load, gross margin','went from −20% to −3%.'],[667,292]],
 ['4',175,24,['Amazon: 40.7% owner before the IPO,','30.4% after. Later: “down to zero.”'],[112,46]],
 ['8',640,28,['Merrill Lynch pitched 50+ buyers','in 2000. Fewer than 8 would visit.'],[862,202]],
 ['s',18,452,['Retail chains next door: PetSmart and','Petco backed rival e-tailers and lent','them their warehouses.'],[100,424]],
 ['r',330,540,['Dashed rings = 1,000 miles from each','warehouse. Illustrative, not carrier zones.'],[268,506]],
