function drawMix(){mk('mixChart',{type:'doughnut',data:{labels:['Advertising','Other M&S (derived)'],datasets:[{data:[26.934,15.557],backgroundColor:[RED,'#c9b48a'],borderColor:'#fcfbf7',borderWidth:3}]},options:{cutout:'62%',plugins:{legend:{position:'bottom'},tooltip:{...tip,callbacks:{label:c=>` $${c.raw.toFixed(1)}M (${(c.raw/42.491*100).toFixed(0)}%)`}}}}})}
// cap table
const CAP=[['Amazon.com',30.4,'#1d1b18','40.7% before the IPO. Director Mark Britto was Amazon’s VP of strategic alliances.'],['Hummer Winblad',15.8,'#3d5f86','21.2% before the IPO. Partner John Hummer sat on the board.'],['Greg McLemore',5.1,'#93743a','Founder of the original WebMagic site.'],['Bowman Capital',4.7,'#6f8f6a','Institutional investor.'],['Catalyst (Disney)',3.7,'#8a5a9a','Disney affiliate, Burbank. Stock issued partly for ABC airtime.'],['Julie Wainwright',3.1,'#a8321f','CEO. Includes options.'],['Chris Deyo',1.8,'#c9553f','President. Includes options.'],['IPO public float',25.4,'#c9b48a','7.5M shares sold at $11 (derived %).'],['All other holders',10.0,'#ddd3c2','Other investors, employees, options (derived remainder).']];
function drawCapT(){const cl=$('#capList');cl.innerHTML=CAP.map((c,i)=>`<div data-i="${i}" title="${c[3]}"><span class="sw-c" style="background:${c[2]}"></span><span>${c[0]}<br><small style="color:var(--mute);font-size:12px">${c[3]}</small></span><b>${c[1].toFixed(1)}%</b></div>`).join('');
 mk('capChart',{type:'doughnut',data:{labels:CAP.map(c=>c[0]),datasets:[{data:CAP.map(c=>c[1]),backgroundColor:CAP.map(c=>c[2]),borderColor:'#fcfbf7',borderWidth:2,hoverOffset:14}]},options:{cutout:'58%',layout:{padding:12},plugins:{legend:{display:false},tooltip:{...tip,callbacks:{label:c=>` ${c.label}: ${c.raw}%`}}},
 onHover:(e,a)=>{$$('#capList div').forEach((d,i)=>d.classList.toggle('hl',a.length&&a[0].index===i))}}});
 $$('#capList div').forEach(d=>{const h=()=>{const ch=charts.capChart,i=+d.dataset.i;ch.setActiveElements([{datasetIndex:0,index:i}]);ch.tooltip.setActiveElements([{datasetIndex:0,index:i}],{x:0,y:0});ch.update();$$('#capList div').forEach(x=>x.classList.toggle('hl',x===d))};d.onmouseenter=h;d.onclick=h})}
// stock vs nasdaq
const D0=Date.UTC(2000,1,11),day=s=>Math.round((Date.parse(s)-D0)/864e5);
const IP=[['2000-02-11',11,'IPO price'],['2000-11-06',0.66,'Prior close (derived)'],['2000-11-07',0.22,'Wind-down announced'],['2000-12-29',0.09375,'Last trading day of 2000'],['2001-01-18',0.125,'Dissolution; delisted']];
const QR=[['2000-02-11','2000-03-31',3.88,14],['2000-04-01','2000-06-30',1.88,4.63],['2000-07-01','2000-09-30',0.59,2.44],['2000-10-01','2000-12-31',0.06,0.81]];
function drawStk(m='lin'){const lg=m==='log';const nq=NQ.filter(p=>p[0]>='2000-02-11'&&p[0]<='2001-01-26').map(p=>({x:day(p[0]),y:+(p[1]/4395.45*100).toFixed(1)}));nq.unshift({x:0,y:100});
 const ranges=QR.map((q,i)=>({label:i?'':'IPET quarterly high–low',data:[{x:(day(q[0])+day(q[1]))/2,y:q[2]/11*100},{x:(day(q[0])+day(q[1]))/2,y:q[3]/11*100}],borderColor:'rgba(168,50,31,.2)',borderWidth:mob()?12:20,pointRadius:0,borderCapStyle:'butt',showLine:true}));
 const mon=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
 mk('stkChart',{type:'line',data:{datasets:[{label:'Nasdaq (indexed)',data:nq,borderColor:INK,borderWidth:1.8,pointRadius:0,tension:.15},
 {label:'IPET documented closes (indexed)',data:IP.map(p=>({x:day(p[0]),y:p[1]/11*100})),borderColor:RED,backgroundColor:'#fcfbf7',pointBorderColor:RED,pointBorderWidth:2.5,pointRadius:6,borderWidth:2,borderDash:[4,4]},...ranges]},
 options:{interaction:{mode:'nearest',intersect:true},plugins:{legend:{position:'bottom',labels:{filter:l=>l.datasetIndex<2}},tooltip:{...tip,callbacks:{title:c=>{const d=new Date(D0+c[0].raw.x*864e5);return d.toISOString().slice(0,10)},label:c=>{if(c.datasetIndex===1){const p=IP[c.dataIndex];return ` IPET $${p[1]} → ${c.raw.y.toFixed(1)} · ${p[2]}`}if(c.datasetIndex===0)return ` Nasdaq index: ${c.raw.y}`;const q=QR[c.datasetIndex-2];return ` IPET range $${q[2]}–$${q[3]}`}}}},
 scales:{y:{type:lg?'logarithmic':'linear',min:lg?0.5:0,max:lg?200:140,grid:{color:GRID},ticks:{callback:v=>lg&&![0.5,1,2,5,10,20,50,100,200].includes(+v)?'':v}},x:{type:'linear',min:-5,max:350,grid:{display:false},afterBuildTicks:a=>{a.ticks=[];for(let m=1;m<=12;m+=mob()?3:2){a.ticks.push({value:Math.round((Date.UTC(2000,m,1)-D0)/864e5)})}},ticks:{callback:v=>{const d=new Date(D0+v*864e5+864e5);return mon[d.getUTCMonth()]+" '"+String(d.getUTCFullYear()).slice(2)}}}}}})}
seg('stkSeg',drawStk);
function drawHC(){mk('hcChart',{type:'bar',data:{labels:['Mar 31, ’99','Sep 30, ’99','Dec 31, ’99','Nov 7, ’00','Dec 31, ’00','Jan 16, ’01'],datasets:[{label:'Employees',data:[4,123,270,320,26,0],backgroundColor:['#c9b48a','#c9b48a','#c9b48a',INK,RED,RED],borderRadius:2}]},
 options:{plugins:{legend:{display:false},tooltip:{...tip,callbacks:{label:c=>' '+c.raw+' employees',footer:c=>['','','','~255 laid off that day','After layoffs','All remaining staff resigned'][c[0].dataIndex]}}},scales:{y:{grid:{color:GRID}},x:{grid:{display:false},ticks:{font:{size:mob()?9:11},maxRotation:0,autoSkip:false}}}}})}
function drawCL(){mk('capLossChart',{type:'bar',data:{labels:['Cash raised','Net losses'],datasets:[{label:'Private preferred (1999)',data:[109.2,0],backgroundColor:GREEN,stack:'a'},{label:'IPO net proceeds',data:[75.3,0],backgroundColor:'#9db894',stack:'a'},{label:'Petstore.com cash',data:[3,0],backgroundColor:'#c9d8c3',stack:'a'},{label:'Cumulative net loss to Sep 30, 2000',data:[0,146.6],backgroundColor:RED,stack:'a'}]},
 options:{indexAxis:'y',plugins:{legend:{position:'bottom',labels:{font:{size:11}}},tooltip:{...tip,filter:c=>c.raw>0,callbacks:{label:c=>' '+c.dataset.label+': $'+c.raw+'M'}}},scales:{x:{stacked:true,grid:{color:GRID},ticks:{callback:v=>'$'+v+'M'}},y:{stacked:true,grid:{display:false}}}}})}
function drawRival(){mk('rivalChart',{type:'bar',data:{labels:['Pets.com','Petopia','Petstore.com','PetSmart.com'],datasets:[
 {label:'Private rounds',data:[109.2,null,97,50],backgroundColor:[RED,PLUM,PLUM,PLUM],stack:'a'},{label:'Petopia: Jul ’99 round',data:[null,66,null,null],backgroundColor:'#b796c2',stack:'a'},{label:'Petopia: Dec ’99 round',data:[null,35,null,null],backgroundColor:PLUM,stack:'a'},
 {label:'Parent cash contributions',data:[null,null,null,20],backgroundColor:'#b796c2',stack:'a'},{label:'IPO gross proceeds',data:[82.5,null,null,null],backgroundColor:'#d98d7c',stack:'a'}]},
 options:{indexAxis:'y',plugins:{legend:{position:'bottom',labels:{font:{size:11}}},tooltip:{...tip,filter:c=>c.raw!=null,callbacks:{label:c=>` ${c.dataset.label}: $${c.raw}M`}}},scales:{x:{stacked:true,grid:{color:GRID},ticks:{callback:v=>'$'+v+'M'}},y:{stacked:true,grid:{display:false}}}}})}
function drawVS(){mk('vsChart',{type:'bar',data:{labels:[['Pets.com','lifetime'],['Chewy','2012'],['Chewy','2016'],['Chewy','FY2024']],datasets:[{label:'Revenue',data:[31.555e6,26e6,0.9e9,11.861e9],backgroundColor:[RED,GREEN,GREEN,GREEN],borderRadius:2,barPercentage:.6}]},
 options:{plugins:{legend:{display:false},tooltip:{...tip,callbacks:{label:c=>{const v=c.raw;return ' '+(v>=1e9?'$'+(v/1e9).toFixed(2)+'B':'$'+(v/1e6).toFixed(1)+'M')}}}},scales:{y:{type:'logarithmic',min:1e7,max:2e10,grid:{color:GRID},ticks:{callback:v=>({1e7:'$10M',1e8:'$100M',1e9:'$1B',1e10:'$10B'})[v]||''}},x:{grid:{display:false}}}}})}
const LAZY={ipoChart:()=>drawIPO(),nasdaqChart:drawNQ,econChart:()=>drawEcon(),custChart:drawCust,plChart:()=>drawPL(),mixChart:drawMix,capChart:drawCapT,stkChart:()=>drawStk(),hcChart:drawHC,capLossChart:drawCL,rivalChart:drawRival,vsChart:drawVS};
if(hasChart){const cIO=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){LAZY[e.target.id]();cIO.unobserve(e.target)}}),{rootMargin:'200px 0px'});Object.keys(LAZY).forEach(id=>$('#'+id)&&cIO.observe($('#'+id)))}
