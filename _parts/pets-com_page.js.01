const SVGNS='http://www.w3.org/2000/svg';
const el=(t,a,p)=>{const e=document.createElementNS(SVGNS,t);for(const k in a)e.setAttribute(k,a[k]);p&&p.appendChild(e);return e};
function drawPins(svg,list,keyEl,r){
 const g=el('g',{class:'pins'},svg);
 list.forEach((m,i)=>{const [lab,cat,tp,pp]=m;const p=pp||tp;const c=PC[cat];
  if(pp){el('line',{x1:tp[0],y1:tp[1],x2:p[0],y2:p[1],stroke:c[1],'stroke-width':1.2},g);el('circle',{cx:tp[0],cy:tp[1],r:2.6,fill:c[1]},g)}
  const pg=el('g',{class:'pin','data-i':i,tabindex:0,role:'button','aria-label':lab+': '+m[4]},g);
  el('circle',{class:'pd',cx:p[0],cy:p[1],r:r,fill:c[0],filter:'url(#pinShadow)'},pg);
  const t=el('text',{class:'pn',x:p[0],y:p[1]+r*0.38,'text-anchor':'middle','font-size':r*1.08},pg);t.textContent=lab;
 });
 keyEl.innerHTML=list.map((m,i)=>`<li data-i="${i}"><span class="kn" style="background:${PC[m[1]][0]}">${m[0]}</span><div><b>${m[4]}</b><br>${m[5]} ${fn(m[6])}</div></li>`).join('');
 const sel=i=>{svg.querySelectorAll('.pin').forEach(x=>x.classList.toggle('sel',+x.dataset.i===i));keyEl.querySelectorAll('li').forEach(x=>x.classList.toggle('sel',+x.dataset.i===i))};
 svg.querySelectorAll('.pin').forEach(x=>{x.onclick=()=>{sel(+x.dataset.i);const li=keyEl.children[+x.dataset.i];if(innerWidth<700)li.scrollIntoView({behavior:'smooth',block:'center'})};x.onkeydown=e=>{if(e.key==='Enter')x.onclick()}});
 keyEl.querySelectorAll('li').forEach(li=>li.onmouseenter=li.onclick=()=>sel(+li.dataset.i));
}
function defs(svg){const d=el('defs',{},svg);const f=el('filter',{id:'pinShadow',x:'-50%',y:'-50%',width:'200%',height:'200%'},d);el('feDropShadow',{dx:0,dy:1,stdDeviation:1.2,'flood-color':'#000','flood-opacity':.22},f)}
function drawNotes(svg,notes,fs,seedBase){
 if(typeof rough==='undefined')return;const rc=rough.svg(svg);const g=el('g',{class:'anno'},svg);
 notes.forEach((n,k)=>{const [lab,x,y,lines,tgt]=n;
  const t=el('text',{x:x+12,y:y+fs+4,'font-size':fs,'font-weight':600},g);
  lines.forEach((ln,j)=>{const ts=el('tspan',{x:x+12,dy:j?fs*1.1:0},t);ts.textContent=ln});
  let bb=t.getBBox();if(!bb.width)bb={width:Math.max(...lines.map(l=>l.length))*fs*.42,height:lines.length*fs*1.1+4};const w=bb.width+24,h=bb.height+16;
  const box=rc.rectangle(x,y,w,h,{roughness:1.3,stroke:INKH,strokeWidth:1.4,fill:'#fffdf6',fillStyle:'solid',seed:seedBase+k*7});
  g.insertBefore(box,t);
  // arrow from nearest box edge point to target
  const cx=Math.max(x,Math.min(tgt[0],x+w)),cy=Math.max(y,Math.min(tgt[1],y+h));
  let sx=cx,sy=cy;if(cx>x&&cx<x+w&&cy>y&&cy<y+h){sx=x+w/2;sy=y+h}
  const mx=(sx+tgt[0])/2+(tgt[1]-sy)*0.18,my=(sy+tgt[1])/2-(tgt[0]-sx)*0.18;
  g.appendChild(rc.curve([[sx,sy],[mx,my],[tgt[0],tgt[1]]],{roughness:1.1,stroke:INKH,strokeWidth:1.6,seed:seedBase+k*7+1}));
  const ang=Math.atan2(tgt[1]-my,tgt[0]-mx),L=11;
  [0.45,-0.45].forEach((da,q)=>g.appendChild(rc.line(tgt[0],tgt[1],tgt[0]-L*Math.cos(ang+da),tgt[1]-L*Math.sin(ang+da),{roughness:.8,stroke:INKH,strokeWidth:1.6,seed:seedBase+k*7+2+q})));
 });
 return g}
function roughMarks(svg){if(typeof rough==='undefined')return;const rc=rough.svg(svg);const g=svg.querySelector('.anno');if(!g)return;
