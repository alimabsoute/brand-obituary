/* Pets.com post-mortem page script (v3). */
document.addEventListener("DOMContentLoaded",()=>{
const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];
const INK='#1d1b18',RED='#a8321f',GOLD='#93743a',GREEN='#4f7a4a',BLUE='#3d5f86',GRID='#ebe9e3',MUTE='#6d665c',PLUM='#8a5a9a';
const fn=ss=>ss.map(s=>`<sup class="fn"><a href="#src-${s}">${s}</a></sup>`).join('');
// progress + reveal
addEventListener('scroll',()=>{const h=document.documentElement;$('#prog').style.width=(h.scrollTop/(h.scrollHeight-h.clientHeight)*100)+'%'},{passive:true});
const rvIO=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');rvIO.unobserve(e.target)}}),{threshold:.08,rootMargin:'0px 0px -5% 0px'});
$$('.rv').forEach(el=>rvIO.observe(el));
// nav active
const secs=$$('section[id]');const navA=$$('nav.top a');
const navIO=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){navA.forEach(a=>a.classList.toggle('on',a.getAttribute('href')==='#'+e.target.id))}}),{rootMargin:'-45% 0px -50% 0px'});
secs.forEach(s=>navIO.observe(s));
// story
const chIO=new IntersectionObserver(es=>es.forEach(e=>{if(!e.isIntersecting)return;const d=e.target.dataset;
 $('#stN').textContent=`Chapter ${+d.n} of 5`;$('#stBig').textContent=d.big;$('#stBig').style.color=d.color;$('#stCap').innerHTML=d.cap;$('#stBar').style.width=d.bar+'%';
 $('#sock').style.transform=`rotate(${(+d.n-3)*4}deg) translateY(${(+d.n-1)*8}px)`;$('#sock').style.opacity=d.n==='05'?.07:.16;
 $$('.chap').forEach(c=>c.classList.toggle('active',c===e.target))}),{rootMargin:'-40% 0px -50% 0px'});
$$('.chap').forEach(c=>chIO.observe(c));
// wayback tabs
$$('#wbStrip button').forEach(b=>b.onclick=()=>{$$('#wbStrip button').forEach(x=>x.classList.toggle('on',x===b));$$('.wb-view').forEach(v=>v.hidden=v.dataset.i!==b.dataset.i)});
// timeline filter
$$('#tlf .chip').forEach(c=>c.onclick=()=>{$$('#tlf .chip').forEach(x=>x.classList.toggle('on',x===c));const f=c.dataset.f;$$('#tlv .ev').forEach(e=>e.classList.toggle('hide',f!=='all'&&e.dataset.cat!==f))});
// fork
$$('#forkTabs button').forEach(b=>b.onclick=()=>{$$('#forkTabs button').forEach(x=>x.classList.toggle('on',x===b));$$('.fork-panel').forEach((p,i)=>p.classList.toggle('on',i===+b.dataset.i))});
// cause of death
const COD=[
 [30,'Negative unit economics','Cost of goods sold, which includes shipping, was higher than net sales in every reported quarter: −124% gross margin in Q4 1999 and −46% across the company’s life. The prospectus put shipping alone at 100–110% of revenue.',[1,4]],
 [25,'Marketing ahead of demand','$103.1M in marketing &amp; sales over six quarters against $31.6M in sales. In Q4 1999 it spent $5.94 for each $1 of revenue. eCompany Now reported that traffic fell after the Super Bowl ad.',[2,4,15]],
 [20,'The capital window slammed shut','The IPO priced in Feb 2000, four weeks before the Nasdaq peak. In 2000, 81% of IPOs were unprofitable companies, and investors stopped buying. When Merrill Lynch shopped the company, fewer than 8 of 50+ prospects would even visit.',[5,25,26]],
 [15,'Heavy, cheap, bulky products','Litter and kibble cost a lot to ship relative to their price. The prospectus listed “shipping below our actual costs” as a risk. The new owner’s coupon later excluded exactly those staples from its order minimum.',[1,11,36]],
 [10,'A crowded, subsidized field','PetSmart.com, Petopia and Petstore.com all raised $50M+ in 1999. Two had a retail chain behind them to handle fulfillment. Pets.com consolidated Petstore.com only in July 2000.',[7,28,31,33]]];
$('#cod').innerHTML=COD.map((c,i)=>`<div class="cod-row${i?'':' open'}"><div class="cod-top"><div><h4>${c[1]}</h4><div class="cod-bar"><span data-w="${c[0]/30*100}"></span></div></div><div class="cod-pct">${c[0]}%</div></div><div class="cod-body"><p>${c[2]} ${fn(c[3])}</p></div></div>`).join('');
$$('.cod-row').forEach(r=>r.onclick=e=>{if(e.target.tagName==='A')return;r.classList.toggle('open')});
const once=(el,f,th=.2)=>{if(!el)return;const io=new IntersectionObserver(es=>{if(es[0].isIntersecting){f();io.disconnect()}},{threshold:th});io.observe(el)};
once($('#cod'),()=>$$('.cod-bar span').forEach((b,i)=>setTimeout(()=>b.style.width=b.dataset.w+'%',i*180)));
once($('#payout'),()=>$$('#payout .disc').forEach((d,i)=>{d.style.transform='scale(.3)';setTimeout(()=>d.style.transform='scale(1)',150+i*500)}),.3);
once($('#runway'),()=>$$('#runway .rw').forEach((r,i)=>{const c=+r.dataset.cash,t=r.querySelector('.tank .lvl');setTimeout(()=>{t.style.height=(c/70.1*100)+'%';if(+r.dataset.q<1.2)t.classList.add('low')},i*250)}),.3);
// calculator
const RAT={q4:{c:2.24,m:5.94,n:'Q4 1999 ratios'},q3:{c:1.03,m:1.57,n:'Q3 2000 ratios'},tgt:{c:1.00,m:0,n:'S-1 target (no marketing ratio stated)'}};let calcP='q4';
const money=v=>(v<0?'−$':'$')+Math.abs(v).toFixed(2);
function calc(){const v=+$('#calcR').value,r=RAT[calcP],cg=v*r.c,gp=v-cg,mk=v*r.m,net=gp-mk;$('#calcV').textContent='$'+v;
 $('#calcOut').textContent=(net<0?'−$':'$')+Math.abs(net).toFixed(0);$('#calcOut').style.color=net<0?RED:GREEN;$('#calcNote').textContent='profit (loss) per order after marketing · '+r.n;
 $('#calcRows').innerHTML=`<div class="row"><span>Order revenue</span><b>${money(v)}</b></div><div class="row"><span>Goods + shipping (×${r.c.toFixed(2)})</span><b>${money(-cg)}</b></div><div class="row"><span>Gross profit</span><b style="color:${gp<0?RED:GREEN}">${money(gp)}</b></div><div class="row"><span>Marketing &amp; sales (×${r.m.toFixed(2)})</span><b>${money(-mk)}</b></div><div class="row tot"><span>Result</span><b style="color:${net<0?RED:GREEN}">${money(net)}</b></div>`}
$('#calcR').oninput=calc;$$('#calcSeg button').forEach(b=>b.onclick=()=>{calcP=b.dataset.v;$$('#calcSeg button').forEach(x=>x.classList.toggle('on',x===b));calc()});calc();
// ---------- charts ----------
const hasChart=typeof Chart!=='undefined';
if(hasChart){Chart.defaults.color=MUTE;Chart.defaults.font.family="'Inter',system-ui,sans-serif";Chart.defaults.font.size=12;Chart.defaults.borderColor=GRID;Chart.defaults.maintainAspectRatio=false;Chart.defaults.plugins.legend.labels.boxWidth=12;}
const tip={backgroundColor:'#1d1b18',titleColor:'#f7f4ee',bodyColor:'#e6dfd2',footerColor:'#d9b97a',padding:11,titleFont:{family:"Inter",size:12,weight:'600'},bodyFont:{size:12.5},footerFont:{size:11.5,weight:'normal'}};
const mob=()=>innerWidth<600;
const INKH2='#1f2a44';
function rNote(rc,ctx,x,y,lines,tgt,seed){ctx.save();ctx.font="600 17px Caveat, cursive";const w=Math.max(...lines.map(l=>ctx.measureText(l).width))+22,h=lines.length*19+14;
 rc.rectangle(x,y,w,h,{roughness:1.2,stroke:INKH2,strokeWidth:1.3,fill:'#fffdf6',fillStyle:'solid',seed});
 ctx.fillStyle=INKH2;lines.forEach((l,i)=>ctx.fillText(l,x+11,y+22+i*19));
 const sx=Math.max(x,Math.min(tgt[0],x+w)),sy=Math.max(y,Math.min(tgt[1],y+h));const mx=(sx+tgt[0])/2+(tgt[1]-sy)*.15,my=(sy+tgt[1])/2-(tgt[0]-sx)*.15;
 rc.curve([[sx,sy],[mx,my],tgt],{roughness:1,stroke:INKH2,strokeWidth:1.5,seed:seed+1});const an=Math.atan2(tgt[1]-my,tgt[0]-mx);
 [.45,-.45].forEach((d,q)=>rc.line(tgt[0],tgt[1],tgt[0]-10*Math.cos(an+d),tgt[1]-10*Math.sin(an+d),{roughness:.7,stroke:INKH2,strokeWidth:1.5,seed:seed+2+q}));ctx.restore()}
const roughPlug=f=>({id:'roughAnno',afterDraw(c){if(typeof rough==='undefined'||c.width<560)return;f(c,rough.canvas(c.canvas),c.ctx)}});

const charts={};const mk=(id,cfg)=>{charts[id]&&charts[id].destroy();charts[id]=new Chart($('#'+id),cfg)};
const seg=(id,f)=>$$('#'+id+' button').forEach(b=>b.onclick=()=>{$$('#'+id+' button').forEach(x=>x.classList.toggle('on',x===b));f(b.dataset.v)});
const refLine=(val,axis='x',label='')=>({id:'ref'+axis+val,afterDatasetsDraw(c){const s=c.scales[axis],a=c.chartArea,ctx=c.ctx;const p=s.getPixelForValue(val);ctx.save();ctx.strokeStyle=INK;ctx.setLineDash([5,4]);ctx.lineWidth=1.5;ctx.beginPath();if(axis==='x'){ctx.moveTo(p,a.top);ctx.lineTo(p,a.bottom)}else{ctx.moveTo(a.left,p);ctx.lineTo(a.right,p)}ctx.stroke();ctx.setLineDash([]);ctx.fillStyle=INK;ctx.font="600 11px Inter";if(label){if(axis==='x')ctx.fillText(label,p+5,a.top+11);else ctx.fillText(label,a.left+6,p-5)}ctx.restore()}});
// IPO window
const YRS=['1990','1991','1992','1993','1994','1995','1996','1997','1998','1999','2000','2001','2002','2003'];
const IPO_N=[110,286,412,510,402,462,677,474,283,476,380,80,66,63],IPO_R=[10.8,11.9,10.3,12.7,9.6,21.4,17.2,14.0,21.9,71.2,56.3,14.0,9.1,11.7],IPO_NEG=[15,24,29,28,26,30,41,36,46,76,81,49,45,44];
function drawIPO(m='ret'){const line=m==='ret'?IPO_R:IPO_NEG;mk('ipoChart',{data:{labels:YRS,datasets:[
 {type:'line',label:m==='ret'?'Avg. first-day return (%)':'% of IPOs with negative EPS',data:line,borderColor:RED,backgroundColor:RED,yAxisID:'y1',tension:.3,pointRadius:YRS.map(y=>y==='1999'||y==='2000'?6:3),borderWidth:2.5},
 {type:'bar',label:'Number of IPOs',data:IPO_N,backgroundColor:YRS.map(y=>y==='1999'||y==='2000'?'#c9b48a':'#ddd3c2'),borderRadius:2,yAxisID:'y'}]},
 options:{interaction:{mode:'index',intersect:false},plugins:{tooltip:{...tip,footer:null,callbacks:{footer:c=>c[0].label==='2000'?'Pets.com IPO: Feb 11, 2000':c[0].label==='1999'?'Pets.com founded and funded':''}}},
 scales:{y:{position:'left',grid:{color:GRID},title:{display:!mob(),text:'IPOs per year'}},y1:{position:'right',grid:{display:false},min:0,max:m==='ret'?80:100,ticks:{callback:v=>v+'%'}},x:{grid:{display:false},ticks:{maxRotation:0,autoSkip:true,callback:function(v,i){return mob()&&i%2?'':YRS[i]}}}}}})}
seg('ipoSeg',drawIPO);
// Nasdaq
const NQ=[["1999-01-08",2344.41],["1999-01-15",2348.2],["1999-01-22",2338.88],["1999-01-29",2505.89],["1999-02-05",2373.62],["1999-02-12",2321.89],["1999-02-19",2283.6],["1999-02-26",2288.03],["1999-03-05",2337.11],["1999-03-12",2381.53],["1999-03-19",2421.27],["1999-03-26",2419.17],["1999-04-01",2493.37],["1999-04-09",2593.05],["1999-04-16",2484.04],["1999-04-23",2590.69],["1999-04-30",2542.85],["1999-05-07",2503.62],["1999-05-14",2527.86],["1999-05-21",2520.14],["1999-05-28",2470.52],["1999-06-04",2478.34],["1999-06-11",2447.88],["1999-06-18",2563.44],["1999-06-25",2552.65],["1999-07-02",2741.02],["1999-07-09",2793.07],["1999-07-16",2864.48],["1999-07-23",2692.4],["1999-07-30",2638.49],["1999-08-06",2547.97],["1999-08-13",2637.81],["1999-08-20",2648.33],["1999-08-27",2758.9],["1999-09-03",2843.11],["1999-09-10",2887.06],["1999-09-17",2869.62],["1999-09-24",2740.41],["1999-10-01",2736.85],["1999-10-08",2886.57],["1999-10-15",2731.83],["1999-10-22",2816.52],["1999-10-29",2966.43],["1999-11-05",3102.29],["1999-11-12",3221.15],["1999-11-19",3369.25],["1999-11-26",3447.81],["1999-12-03",3520.63],["1999-12-10",3620.24],["1999-12-17",3753.06],["1999-12-23",3969.44],["1999-12-31",4069.31],["2000-01-07",3882.62],["2000-01-14",4064.27],["2000-01-21",4235.4],["2000-01-28",3887.07],["2000-02-04",4244.14],["2000-02-11",4395.45],["2000-02-18",4411.74],["2000-02-25",4590.5],["2000-03-03",4914.79],["2000-03-10",5048.62],["2000-03-17",4798.13],["2000-03-24",4963.03],["2000-03-31",4572.83],["2000-04-07",4446.45],["2000-04-14",3321.29],["2000-04-20",3643.88],["2000-04-28",3860.66],["2000-05-05",3816.82],["2000-05-12",3529.06],["2000-05-19",3390.4],["2000-05-26",3205.11],["2000-06-02",3813.38],["2000-06-09",3874.84],["2000-06-16",3860.56],["2000-06-23",3845.34],["2000-06-30",3966.11],["2000-07-07",4023.2],["2000-07-14",4246.18],["2000-07-21",4094.45],["2000-07-28",3663.0],["2000-08-04",3787.36],["2000-08-11",3789.47],["2000-08-18",3930.34],["2000-08-25",4042.68],["2000-09-01",4234.33],["2000-09-08",3978.41],["2000-09-15",3835.23],["2000-09-22",3803.76],["2000-09-29",3672.82],["2000-10-06",3361.01],["2000-10-13",3316.77],["2000-10-20",3483.14],["2000-10-27",3278.36],["2000-11-03",3451.58],["2000-11-07",3415.79],["2000-11-10",3028.99],["2000-11-17",3027.19],["2000-11-24",2904.38],["2000-12-01",2645.29],["2000-12-08",2917.43],["2000-12-15",2653.27],["2000-12-22",2517.02],["2000-12-29",2470.52],["2001-01-05",2407.65],["2001-01-12",2626.5],["2001-01-18",2768.49],["2001-01-19",2770.38],["2001-01-26",2781.3],["2001-02-02",2660.5],["2001-02-09",2470.97],["2001-02-16",2425.38],["2001-02-23",2262.51],["2001-02-28",2151.83]];
const NQE=[['1999-02-17',2248.91,'Pets.com begins operations'],['2000-02-11',4395.45,'IPET IPO at $11'],['2000-03-10',5048.62,'Nasdaq peak: 5,048.62'],['2000-11-07',3415.79,'Wind-down announced'],['2001-01-18',2768.49,'Dissolved, delisted']];
function nearest(d){let bi=0,bd=1e15;NQ.forEach((p,i)=>{const dd=Math.abs(Date.parse(p[0])-Date.parse(d));if(dd<bd){bd=dd;bi=i}});return bi}
function drawNQ(){const ev=NQ.map(()=>null),evn=NQ.map(()=>'');NQE.forEach(e=>{const i=nearest(e[0]);ev[i]=e[1];evn[i]=e[2]+' ('+e[0]+')'});
 const mon=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
 mk('nasdaqChart',{type:'line',data:{labels:NQ.map(p=>p[0]),datasets:[
 {label:'Pets.com milestones',data:ev,showLine:false,pointRadius:7,pointHoverRadius:9,pointBackgroundColor:'#fcfbf7',pointBorderColor:RED,pointBorderWidth:2.5},
 {label:'Nasdaq Composite (weekly close)',data:NQ.map(p=>p[1]),borderColor:INK,borderWidth:1.8,pointRadius:0,fill:{target:'origin'},backgroundColor:'rgba(29,27,24,.05)',tension:.15}]},
 options:{interaction:{mode:'nearest',intersect:false},plugins:{tooltip:{...tip,callbacks:{title:c=>c[0].label,label:c=>c.datasetIndex===0?' '+evn[c.dataIndex]+': '+c.raw.toLocaleString():' Nasdaq: '+c.raw.toLocaleString()}}},
 scales:{y:{min:1500,grid:{color:GRID}},x:{grid:{display:false},ticks:{maxRotation:0,autoSkip:false,callback:function(v,i){const d=NQ[i][0];const prev=i?NQ[i-1][0]:'';if(d.slice(5,7)!==prev.slice(5,7)&&['01','07'].includes(d.slice(5,7))||(i===0))return mon[+d.slice(5,7)-1]+" '"+d.slice(2,4);return ''}}}}},plugins:[roughPlug((c,rc,ctx)=>{const m=c.getDatasetMeta(0).data;const ipo=m[nearest('2000-02-11')],pk=m[nearest('2000-03-10')];if(!ipo||!pk)return;rc.ellipse((ipo.x+pk.x)/2,(ipo.y+pk.y)/2,pk.x-ipo.x+46,Math.abs(pk.y-ipo.y)+46,{roughness:1.3,stroke:INKH2,strokeWidth:1.4,seed:5});rNote(rc,ctx,ipo.x-330,c.chartArea.top+8,['IPO priced Feb 11, 2000:','four weeks before the Nasdaq peaked.'],[ipo.x-24,ipo.y-12],9)})]})}
// econ
const ECL=[['S-1: shipping as','described, late 1999'],['S-1: stated','target'],['Actual','Q4 1999'],['Actual','Q1 2000'],['Actual','Q3 2000']];
function drawEcon(m='gross'){const all=m==='all';mk('econChart',{type:'bar',data:{labels:ECL,datasets:[
 {label:'Product cost (S-1 midpoint)',data:[77.5,77.5,null,null,null],backgroundColor:'#c9b48a',stack:'s'},
 {label:'Shipping (S-1 midpoint)',data:[105,22.5,null,null,null],backgroundColor:GOLD,stack:'s'},
 {label:'Goods + shipping (actual COGS)',data:[null,null,224,164,103],backgroundColor:'#7a5a2c',stack:'s'},
 ...(all?[{label:'Marketing & sales',data:[null,null,594,377,157],backgroundColor:RED,stack:'s'}]:[])]},
 options:{indexAxis:'y',plugins:{legend:{position:'bottom'},tooltip:{...tip,callbacks:{label:c=>c.raw==null?'':` ${c.dataset.label}: $${c.raw} per $100`,footer:c=>{const i=c[0].dataIndex;const t=[[77.5+105,0],[100,0],[224,594],[164,377],[103,157]][i];return 'Total: $'+(t[0]+(all?t[1]:0)).toFixed(0)+' per $100 of sales'}}}},
 scales:{x:{stacked:true,min:0,max:all?850:250,grid:{color:GRID},ticks:{callback:v=>'$'+v}},y:{stacked:true,grid:{display:false},ticks:{font:{size:mob()?10:12}}}}},plugins:[refLine(100,'x','$100 = revenue'),...(all?[]:[roughPlug((c,rc,ctx)=>{const xs=c.scales.x,ys=c.scales.y;rNote(rc,ctx,xs.getPixelForValue(128),ys.getPixelForValue(3.15),['Anything past the dashed line:','each $100 of sales cost more','than $100 to deliver.'],[xs.getPixelForValue(101),ys.getPixelForValue(4)],21)})])]})}
seg('econSeg',drawEcon);
function drawCust(){mk('custChart',{data:{labels:['Dec 31, ’99','Mar 31, ’00','Jun 30, ’00','Nov ’00'],datasets:[
 {type:'line',label:'Repeat-customer share of orders',data:[39,50,59,null],borderColor:RED,backgroundColor:RED,yAxisID:'y1',pointRadius:5,borderWidth:2.5},
 {type:'bar',label:'Customers (thousands)',data:[144,264,443,570],backgroundColor:['#c9b48a','#c9b48a','#c9b48a','#ddd3c2'],borderRadius:2,yAxisID:'y'}]},
 options:{plugins:{legend:{position:'bottom'},tooltip:{...tip,callbacks:{label:c=>c.dataset.yAxisID==='y1'?(c.raw==null?'':` Repeat: ${c.dataIndex?'>':''}${c.raw}%`):` ${c.dataIndex===3?'~':''}${c.raw}K customers`}}},scales:{y:{grid:{color:GRID},ticks:{callback:v=>v+'K'}},y1:{position:'right',min:0,max:100,grid:{display:false},ticks:{callback:v=>v+'%'}},x:{grid:{display:false}}}}})}
// P&L
const PL={labels:["Q2'99*","Q3'99","Q4'99","Q1'00","Q2'00","Q3'00"],sales:[39,568,5168,7651,8764,9365],cogs:[76,1766,11570,12515,10513,9642],mkt:[1122,10693,30676,28855,17091,14709],loss:[3498,15852,42423,39088,24059,21725]};
const PLN=['Inception (Feb 17) – Jun 30, 1999','TV campaign launches; store v2','Macy’s parade; holiday push','Super Bowl (Jan 30); IPO (Feb 11)','Marketing cut ~41% vs Q1','Last full quarter'];
function drawPL(m='abs'){if(m==='abs'){mk('plChart',{data:{labels:PL.labels,datasets:[
 {type:'line',label:'Net loss',data:PL.loss,borderColor:INK,backgroundColor:INK,borderWidth:2,pointRadius:4,tension:.3,order:0},
 {type:'bar',label:'Net sales',data:PL.sales,backgroundColor:GREEN,borderRadius:2},{type:'bar',label:'Cost of goods sold',data:PL.cogs,backgroundColor:'#c9b48a',borderRadius:2},{type:'bar',label:'Marketing & sales',data:PL.mkt,backgroundColor:RED,borderRadius:2}]},
 options:{interaction:{mode:'index',intersect:false},plugins:{legend:{position:'bottom'},tooltip:{...tip,callbacks:{label:c=>' '+c.dataset.label+': $'+(c.raw/1000).toFixed(2)+'M',footer:c=>PLN[c[0].dataIndex]}}},scales:{y:{grid:{color:GRID},ticks:{callback:v=>'$'+v/1000+'M'}},x:{grid:{display:false}}}}})}
 else{const r=k=>PL[k].map((v,i)=>+(v/PL.sales[i]).toFixed(2));mk('plChart',{type:'bar',data:{labels:PL.labels.slice(1),datasets:[{label:'COGS per $1 of sales',data:r('cogs').slice(1),backgroundColor:'#c9b48a'},{label:'Marketing & sales per $1 of sales',data:r('mkt').slice(1),backgroundColor:RED}]},
 options:{plugins:{legend:{position:'bottom'},tooltip:{...tip,callbacks:{label:c=>` ${c.dataset.label}: $${c.raw.toFixed(2)}`,footer:c=>PLN[c[0].dataIndex+1]}}},scales:{y:{type:'logarithmic',min:.5,max:40,grid:{color:GRID},ticks:{callback:v=>[.5,1,2,5,10,20,40].includes(+v)?'$'+v:''}},x:{grid:{display:false}}}},plugins:[refLine(1,'y','$1 = break-even')]})}}
seg('plSeg',drawPL);
